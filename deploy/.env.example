# ── ORBS Network ──
# SEED_IP: mainnet seed node (used when DEV_NODE_HOST is not set).
SEED_IP=18.211.83.127

# DEV_NODE_HOST: when set, the backend runs in SUBNET mode — uses this single
# node for all sync hash / signed payload calls, skipping mainnet committee
# discovery. To switch to mainnet, leave this empty.
DEV_NODE_HOST=18.117.196.182

LAMBDA_SCRIPT_BASE_URL=/vm-lambda/subnet-sync

# ── Sync Configuration ──
CHECK_INTERVAL=300
DEBUG=false

# Minimum guardian agreement on payloadHash required to submit a sync TX.
# Mainnet default: 3. Subnet single-node testing: 1.
MIN_VOTERS=3

# ── Wallet Manager ──
WALLET_MANAGER_URL=
CMT_SYNC_WALLET_MANAGER_SIGNER_PK=

# ── Express Server ──
# Port for the dashboard and status API. Set to 80 for production.
PORT=80

# ── Database (used by backend) ──
# DB_HOST must be "db" when running via docker-compose (the compose service name).
# For local development, use "localhost".
DB_HOST=db
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=committee_sync

# ── Postgres Container ──
# These are read by the postgres:16 Docker image to initialize the database.
# Keep in sync with DB_* values above.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=committee_sync

# ── Telegram Notifications (optional) ──
# Create a bot via @BotFather, then add it to your channel/group as admin.
# TELEGRAM_CHAT_ID can be obtained from @userinfobot or by checking
# https://api.telegram.org/bot<TOKEN>/getUpdates after sending a message.
# Leave empty to disable notifications (the service still runs normally).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
